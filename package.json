{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:testbilling": "tsx --env-file=.env.testbilling server.ts",
    "seed:demo": "node --env-file=.env.testbilling scripts/seed-subadmin-demo.mjs",
    "razorpay:check": "node scripts/razorpay-check.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "vercel-build": "vite build",
    "netlify-build": "vite build",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "test:security": "node tests/security.test.mjs",
    "test:functional": "node tests/functional.test.mjs",
    "test": "npm run test:security && npm run test:functional && npm run test:app && npm run test:billing && npm run test:subadmin && npm run test:partner && npm run test:plan && npm run test:journey",
    "test:journey": "node tests/journey.test.mjs",
    "test:app": "node tests/app.test.mjs",
    "test:billing": "node tests/billing-rbac.test.mjs",
    "test:subadmin": "node tests/subadmin.test.mjs",
    "test:pro": "node tests/pro-unlock.test.mjs",
    "test:partner": "node tests/partner.test.mjs",
    "test:plan": "node tests/plan-gates.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@marsidev/react-turnstile": "^1.5.4",
    "@supabase/supabase-js": "^2.110.5",
    "@tailwindcss/vite": "^4.1.14",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "fflate": "^0.8.3",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.8",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.546.0",
    "metaapi.cloud-sdk": "^29.3.3",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "serverless-http": "^3.2.0",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "puppeteer": "^25.3.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
