{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/tsx/dist/cli.mjs server.ts",
    "auth:migrate": "node --input-type=module -e \"import { autoMigrateBetterAuth } from './auth.ts'; await autoMigrateBetterAuth();\"",
    "dev:testbilling": "tsx --env-file=.env.testbilling server.ts",
    "razorpay:check": "node scripts/razorpay-check.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "vercel-build": "vite build",
    "netlify-build": "vite build",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "check:migrations": "node scripts/check-migrations.mjs",
    "test:security": "node --env-file-if-exists=.env tests/security.test.mjs",
    "test:functional": "node --env-file-if-exists=.env tests/functional.test.mjs",
    "test": "npm run test:security && npm run test:functional && npm run test:app && npm run test:billing && npm run test:subadmin && npm run test:partner && npm run test:plan && npm run test:journey",
    "test:journey": "node --env-file-if-exists=.env tests/journey.test.mjs",
    "test:app": "node --env-file-if-exists=.env tests/app.test.mjs",
    "test:billing": "node --env-file-if-exists=.env tests/billing-rbac.test.mjs",
    "test:subadmin": "node --env-file-if-exists=.env tests/subadmin.test.mjs",
    "test:pro": "node --env-file-if-exists=.env tests/pro-unlock.test.mjs",
    "test:partner": "node --env-file-if-exists=.env tests/partner.test.mjs",
    "test:plan": "node --env-file-if-exists=.env tests/plan-gates.test.mjs",
    "test:payments": "node --env-file-if-exists=.env tests/payment-replay.test.mjs",
    "test:concurrency": "node --env-file-if-exists=.env tests/concurrency.test.mjs",
    "test:subadmin-scope": "node --env-file-if-exists=.env tests/subadmin-scope.test.mjs"
  },
  "dependencies": {
    "@better-auth/infra": "^0.4.11",
    "@google/genai": "^2.4.0",
    "@marsidev/react-turnstile": "^1.5.4",
    "@supabase/supabase-js": "^2.110.5",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.6",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.546.0",
    "metaapi.cloud-sdk": "^29.3.3",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "serverless-http": "^3.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.22",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
