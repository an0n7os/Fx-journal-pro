# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase database configuration for persistence
SUPABASE_URL=
# SERVER key. Use the service_role secret (Dashboard -> Settings -> API).
# Never use the anon/publishable key here: it is shipped to the browser, so the
# server would only have the access any random visitor already has.
SUPABASE_SERVICE_ROLE_KEY=
# Legacy fallback, kept for local development only.
SUPABASE_KEY=

# SESSION_SECRET: signs the login session cookie (HMAC-SHA256). REQUIRED in
# production - the server refuses to start without it - and must be at least 32
# characters. Changing it logs every user out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Razorpay. Without these the Pro checkout returns 503 rather than upgrading
# anyone. The secret verifies payment signatures server-side and must never
# reach the frontend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The monthly plan, created once in Dashboard -> Subscriptions -> Plans at
# ₹399/month. Pro is a SUBSCRIPTION, not a one-time charge.
# Subscriptions is a separate Razorpay product and is OFF on a new account:
# /v1/plans and /v1/subscriptions answer 401 until you activate it in the
# dashboard, which looks exactly like a wrong secret. `npm run razorpay:check`
# tells the two apart.
# Dashboard > Subscriptions > activate, then Plans > New Plan (399, Monthly).
RAZORPAY_PLAN_ID=
# Set in Dashboard -> Settings -> Webhooks, pointing at
#   https://your-domain/api/payments/webhook
# Subscribe to: subscription.activated, subscription.charged,
# subscription.cancelled, subscription.completed, subscription.halted,
# subscription.pending, subscription.expired
# The webhook is the source of truth for who is Pro — the browser callback is
# only a hint, so this must be set or nobody is ever upgraded.
RAZORPAY_WEBHOOK_SECRET=

# Frontend site URL used after Supabase OAuth redirects
VITE_SITE_URL=https://www.fxjournalpro.com

# MetaApi token for MT5 investor password sync (TradeZella-style broker sync)
# Get your free token at: https://app.metaapi.cloud → Dashboard → API Tokens
# Free tier: 5 MT5 accounts
# When set, the server runs a cloud worker that provisions a MetaApi terminal,
# connects with the (encrypted) investor password, and syncs deals/positions
# through the same pipeline as the EA. When unset, /api/mt5/cloud/connect
# returns 503 CLOUD_WORKER_UNAVAILABLE and the EA method is used instead.
META_API_TOKEN=
# MT5_CLOUD_SYNC_INTERVAL_SECONDS: how often (sec) the cloud worker re-syncs
# connected accounts (default 60, minimum 10).
# MT5_CLOUD_BACKFILL_DAYS: how many days of history the FIRST cloud sync imports
# (default 90). Incremental syncs only pull deals since the last sync.
# MT5_CLOUD_SYNC_INTERVAL_SECONDS=60
# MT5_CLOUD_BACKFILL_DAYS=90

# EA machine-to-machine auth hardening (Phase 2)
# EA_ALLOW_LEGACY_TOKEN: when "false", EA requests MUST present an HMAC signature
# (Authorization: Bearer + X-EA-Signature + X-EA-Timestamp). Default true so
# previously downloaded EA files keep working.
EA_ALLOW_LEGACY_TOKEN=true
# EA_SIGNATURE_WINDOW_MIN: replay protection window for X-EA-Timestamp (minutes)
EA_SIGNATURE_WINDOW_MIN=5

# MT5_CREDENTIAL_MASTER_KEY: 32-byte (64 hex chars) master key for the cloud
# bridge (investor-password) method. Investor passwords are encrypted with
# AES-256-GCM under a random DEK that is envelope-wrapped with this key — the
# raw password is never stored. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, POST /api/mt5/cloud/connect returns 503 CLOUD_NOT_CONFIGURED and
# falls back to the EA method (which never touches the password).
MT5_CREDENTIAL_MASTER_KEY=

# SendGrid API Key for sending Email OTP verification codes
# Get your free key at: https://sendgrid.com (Free tier allows 100 emails/day)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Resend API Key for sending Email OTP verification codes
# Get your key at: https://resend.com
RESEND_API_KEY=

# Cloudflare Turnstile Verification Keys — REQUIRED BEFORE LAUNCH
# Get your keys at: https://dash.cloudflare.com/?to=/:account/turnstile
# Add your production domain to the widget's allowed hostnames, or it will
# fail for real visitors while still working on localhost.
#
# Leave the site key empty in a dev build and the widget falls back to
# Cloudflare's always-passes test key, which prints
# "For testing only. If seen, report to site owner" on the sign-in box.
# A production build has no such fallback: it reports the missing key instead.
#
# (VITE_ prefixed so it's exposed to the Vite React frontend, and baked in at
# build time — changing it means rebuilding, not just restarting.)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# FX News (Alpha Vantage News & Sentiment API)
# Free key at: https://www.alphavantage.co/support/#api-key (25 requests/day)
ALPHA_VANTAGE_API_KEY=

# Economic Calendar (modular provider, cached server-side)
# Providers: "xoomar" (free, no key, default — US CPI/NFP/FOMC/GDP from BLS/Fed/BEA),
#            "finnhub" (free tier used to include the calendar — currently restricted),
#            "fmp" (paid plan required)
ECONOMIC_CALENDAR_PROVIDER=xoomar

# Xoomar Economic Calendar needs no API key (30 req/min/IP; optional free key at https://xoomar.com/signup)
# Docs: https://xoomar.com/markets/api/calendar

# Finnhub API Key for the Economic Calendar (only if using ECONOMIC_CALENDAR_PROVIDER=finnhub)
# Free key at: https://finnhub.io/register (note: economic calendar may be restricted on free tier)
FINNHUB_API_KEY=

# Financial Modeling Prep API Key (only if using ECONOMIC_CALENDAR_PROVIDER=fmp)
# Free key at: https://site.financialmodelingprep.com/ (note: free tier does NOT include the calendar)
FMP_API_KEY=
