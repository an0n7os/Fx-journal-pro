# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase database configuration for persistence
SUPABASE_URL=
# SERVER key. Dashboard -> Settings -> API keys -> the SECRET one:
#   new format:    sb_secret_...          (NOT sb_publishable_...)
#   legacy format: the service_role JWT   (NOT the anon JWT)
# Never use the anon/publishable key here: it is shipped to the browser, so the
# server would only have the access any random visitor already has. The server
# reads the key's own shape and refuses to start in production if a public one
# is given, because the two sit next to each other in the dashboard.
SUPABASE_SERVICE_ROLE_KEY=
# Legacy fallback, kept for local development only.
SUPABASE_KEY=

# SESSION_SECRET: signs the login session cookie (HMAC-SHA256). REQUIRED in
# production - the server refuses to start without it - and must be at least 32
# characters. Changing it logs every user out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Razorpay Payments. Without these the Pro checkout returns 503 rather than
# upgrading anyone. The key id is shared with the client; the secret
# authenticates every API call and verifies HMAC signatures, and must never reach
# the frontend.
#   Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: Webhook secret configured in Razorpay Dashboard > Settings > Webhooks
# pointing at https://your-domain/api/payments/webhook
# Subscribe to: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=
# Optional: Legacy Razorpay Plan ID for subscriptions
RAZORPAY_PLAN_ID=

# Frontend site URL used after Supabase OAuth redirects
VITE_SITE_URL=https://www.fxjournalpro.com

# Desktop MT5 bridge (src/mt5-integration-kit/python_worker/worker.py).
# Defaults to MT5_WORKER_TOKEN, because both pull the same jobs and both
# receive a decrypted investor password — one secret, one rotation. Set this
# only if you want the desktop bridge on a separate token. There is NO literal
# fallback: unset means the bridge endpoints answer 503.
# BRIDGE_AUTH_TOKEN=

# MetaApi token for MT5 investor password sync (TradeZella-style broker sync).
#
# REQUIRES A PACKAGE THAT IS NO LONGER INSTALLED. metaapi.cloud-sdk was removed
# because it was 45MB and carried thirteen of this project's sixteen production
# advisories, including both criticals, while its code path could not run on
# Netlify at all (cloudSyncAvailable() requires !IS_SERVERLESS). To use this:
#
#   npm i metaapi.cloud-sdk
#
# and move the sync off the setInterval worker, which a serverless platform
# freezes — see getCloudApi() in server.ts. Without the package the server
# still boots and logs that cloud sync is unavailable.
#
# Free token: https://app.metaapi.cloud → Dashboard → API Tokens (5 accounts).
# Unset, /api/mt5/cloud/connect returns 503 CLOUD_WORKER_UNAVAILABLE and the
# EA or VPS method is used instead.
META_API_TOKEN=
# MT5_CLOUD_SYNC_INTERVAL_SECONDS: how often (sec) the cloud worker re-syncs
# connected accounts (default 60, minimum 10).
# MT5_CLOUD_BACKFILL_DAYS: how many days of history the FIRST cloud sync imports
# (default 90). Incremental syncs only pull deals since the last sync.
# MT5_CLOUD_SYNC_INTERVAL_SECONDS=60
# MT5_CLOUD_BACKFILL_DAYS=90

# EA machine-to-machine auth hardening (Phase 2)
# EA_ALLOW_LEGACY_TOKEN: when "false", EA requests MUST present an HMAC signature
# (Authorization: Bearer + X-EA-Signature + X-EA-Timestamp). Default true so
# previously downloaded EA files keep working.
EA_ALLOW_LEGACY_TOKEN=true
# EA_SIGNATURE_WINDOW_MIN: replay protection window for X-EA-Timestamp (minutes)
EA_SIGNATURE_WINDOW_MIN=5

# MT5_CREDENTIAL_MASTER_KEY: 32-byte (64 hex chars) master key for the cloud
# bridge (investor-password) method. Investor passwords are encrypted with
# AES-256-GCM under a random DEK that is envelope-wrapped with this key — the
# raw password is never stored. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, POST /api/mt5/cloud/connect returns 503 CLOUD_NOT_CONFIGURED and
# falls back to the EA method (which never touches the password).
MT5_CREDENTIAL_MASTER_KEY=

# ── Self-hosted VPS sync (our own Windows VPS + Python worker) ────────────────
#
# This is the recommended automatic sync method. The Python worker in /worker/
# runs on a Windows VPS beside a MetaTrader 5 installation. It polls the backend
# for pending jobs, logs into MT5 with the customer's Investor (read-only)
# password, fetches deal history, and hands it back.
#
# MT5_VPS_SYNC_ENABLED: set to "true" to enable this method. When true and
#   MT5_WORKER_TOKEN is also set, the UI shows an "Auto Sync" option for users.
#   The /api/mt5/worker/* endpoints become active.
MT5_VPS_SYNC_ENABLED=false
#
# MT5_WORKER_TOKEN: a long random secret shared between this server and the VPS
#   worker. FXJP_WORKER_TOKEN on the VPS must equal this value.
#   Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   This token can retrieve any connected customer's investor password over HTTPS,
#   so treat it like a database password — rotate it if the VPS is ever compromised.
MT5_WORKER_TOKEN=
#
# MT5_CLOUD_BACKFILL_DAYS: how many days of history the first VPS sync imports
#   (default 90). Incremental syncs resume from the last deal ticket.
# MT5_CLOUD_BACKFILL_DAYS=90


# SendGrid API Key for sending Email OTP verification codes
# Get your free key at: https://sendgrid.com (Free tier allows 100 emails/day)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Resend API Key for sending Email OTP verification codes
# Get your key at: https://resend.com
RESEND_API_KEY=

# Cloudflare Turnstile Verification Keys — REQUIRED BEFORE LAUNCH
# Get your keys at: https://dash.cloudflare.com/?to=/:account/turnstile
# Add your production domain to the widget's allowed hostnames, or it will
# fail for real visitors while still working on localhost.
#
# Leave the site key empty in a dev build and the widget falls back to
# Cloudflare's always-passes test key, which prints
# "For testing only. If seen, report to site owner" on the sign-in box.
# A production build has no such fallback: it reports the missing key instead.
#
# (VITE_ prefixed so it's exposed to the Vite React frontend, and baked in at
# build time — changing it means rebuilding, not just restarting.)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# FX News (Alpha Vantage News & Sentiment API)
# Free key at: https://www.alphavantage.co/support/#api-key (25 requests/day)
ALPHA_VANTAGE_API_KEY=

# Economic Calendar (modular provider, cached server-side)
# Providers: "xoomar" (free, no key, default — US CPI/NFP/FOMC/GDP from BLS/Fed/BEA),
#            "finnhub" (free tier used to include the calendar — currently restricted),
#            "fmp" (paid plan required)
ECONOMIC_CALENDAR_PROVIDER=xoomar

# Xoomar Economic Calendar needs no API key (30 req/min/IP; optional free key at https://xoomar.com/signup)
# Docs: https://xoomar.com/markets/api/calendar

# Finnhub API Key for the Economic Calendar (only if using ECONOMIC_CALENDAR_PROVIDER=finnhub)
# Free key at: https://finnhub.io/register (note: economic calendar may be restricted on free tier)
FINNHUB_API_KEY=

# Financial Modeling Prep API Key (only if using ECONOMIC_CALENDAR_PROVIDER=fmp)
# Free key at: https://site.financialmodelingprep.com/ (note: free tier does NOT include the calendar)
FMP_API_KEY=

# ── Local developer account ───────────────────────────────────────────────────
# The one account the server seeds for local work and the test suite. Both
# variables are required before it exists, and IS_DEV gates it, so a production
# deployment has no privileged account it could be signed into.
#
# It replaces the demo identities this project used to ship: admin@axyfx.com and
# demo@axyfx.com minted a SUPER_ADMIN from a hardcoded hash, and two seed SQL
# files plus a seed script carried ten more.
DEV_ACCOUNT_EMAIL=dev@localhost
DEV_ADMIN_PASSWORD=

# ── OpenRouter AI Mentor (Gemma Free / GPT-4o) ────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
