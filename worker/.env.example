# Copy to .env beside mt5_worker.py, one per worker. Never commit the real file.

# Where the backend lives. Must be https in production — the claim response
# carries a customer's investor password.
FXJP_API_URL=https://www.fxjournalpro.com/api/mt5

# Must equal MT5_WORKER_TOKEN on the backend. This token can pull any connected
# customer's investor password, so treat it like a database password.
FXJP_WORKER_TOKEN=

# Anything that identifies this process in the logs and in the job record.
FXJP_WORKER_ID=vps1-terminal1

# THIS worker's own terminal. Each worker needs its own installation directory —
# two workers sharing one terminal will cross each other's sessions.
MT5_TERMINAL_PATH=C:\MT5\terminal1\terminal64.exe

# Seconds to wait when the queue is empty.
FXJP_POLL_SECONDS=10
